# NEXT_PUBLIC_GUN_PEERS=
# Comma-separated Gun relay URLs, e.g.
# NEXT_PUBLIC_GUN_PEERS=https://your-relay.example.com/gun,https://another-relay.example.com/gun

# NEXT_PUBLIC_AUTH_API=
# Base URL of the openq-auth worker (Dawn standard auth backend,
# worker/ in this repo). Defaults to the production worker when unset.
